# Copy this file to .env and fill in what you have. Everything is optional:
# without any LLM key the app still runs (dashboard, cleaning, forecast, statistics, reports).

# --- LLM keys (add at least one for the AI features). Comma-separate several keys to rotate. ---
GROQ_API_KEY=            # free tier: https://console.groq.com
GOOGLE_API_KEY=          # free tier: https://aistudio.google.com  (also enables embeddings for document Q&A)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=

# Optional: override models / try providers in this order
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER_ORDER=groq,gemini,openrouter,openai,xai

# --- Authentication (optional). Leave empty to run in demo mode with a role switcher. ---
SUPABASE_URL=
SUPABASE_KEY=            # the public "anon" key, never the service_role key
DEFAULT_ROLE=analyst     # role given to users whose Supabase app_metadata has no role

# --- Limits (optional) ---
# MAX_UPLOAD_MB=50
# SANDBOX_TIMEOUT_S=20
# SANDBOX_MAX_MEMORY_MB=2048
# MAX_REPAIR_ATTEMPTS=2
